    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/xp-multi/icon.png",
  "environment": "server",
  "entrypoints": {
    "main": ["com.omarlawatey.Xpmulti"],
    "client": ["com.omarlawatey.XpmultiClient"]
